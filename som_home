<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>솜하치 (Somhachi) 공식 홈페이지</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #fdf5f7;
            --main-pink: #f16a8b;
            --sub-pink: #f7a1b4;
            --card-bg: #ffffff;
            --text-dark: #333333;
            --text-light: #777777;
            --border-radius: 16px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Noto Sans KR', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-dark);
            display: flex;
            justify-content: center;
            min-height: 100vh;
            padding: 20px 15px;
            overflow-x: hidden;
            -webkit-tap-highlight-color: transparent;
        }

        .container {
            width: 100%;
            max-width: 480px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            padding-bottom: 40px;
        }

        /* 부드러운 네모 카드 스타일 */
        .card {
            background: var(--card-bg);
            border-radius: var(--border-radius);
            padding: 24px;
            box-shadow: 0 4px 16px rgba(241, 106, 139, 0.06);
            border: 1px solid rgba(241, 106, 139, 0.12);
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--main-pink);
            margin-bottom: 16px;
            padding-bottom: 8px;
            border-bottom: 1px solid rgba(241, 106, 139, 0.12);
        }

        /* 프로필 섹션 */
        .profile-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .profile-img-wrap {
            position: relative;
            width: 110px;
            height: 110px;
            margin-bottom: 16px;
        }

        .profile-img {
            width: 100%;
            height: 100%;
            border-radius: 20px; /* 부드러운 네모 느낌 */
            object-fit: cover;
            border: 3px solid var(--sub-pink);
            background-color: #fff0f3;
        }

        .img-edit-btn {
            position: absolute;
            bottom: -6px;
            right: -6px;
            background: var(--main-pink);
            color: white;
            border: none;
            border-radius: 50%;
            width: 34px;
            height: 34px;
            font-size: 14px;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10;
        }

        .profile-name { font-size: 1.5rem; font-weight: 700; margin-bottom: 4px; }
        .profile-sub { color: var(--text-light); font-size: 0.95rem; margin-bottom: 14px; }
        
        .info-grid {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 16px;
            background: #fff8fa;
            padding: 14px;
            border-radius: 12px;
            border: 1px solid rgba(241, 106, 139, 0.08);
            text-align: left;
            font-size: 0.9rem;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
        }

        .info-label { color: var(--text-light); font-weight: 500; }
        .info-value { color: var(--text-dark); font-weight: 700; }

        .tag-list {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 6px;
            margin-bottom: 16px;
        }

        .tag {
            background: rgba(247, 161, 180, 0.15);
            color: var(--main-pink);
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .d-day-wrap {
            display: flex;
            gap: 10px;
            width: 100%;
        }

        .d-day-box {
            flex: 1;
            background: #fff8fa;
            border-radius: 12px;
            padding: 12px;
            text-align: center;
            border: 1px solid rgba(241, 106, 139, 0.1);
        }

        .d-day-title { font-size: 0.8rem; color: var(--text-light); margin-bottom: 4px; }
        .d-day-value { font-size: 1.1rem; font-weight: 700; color: var(--main-pink); }

        /* 링크 바로가기 (부드러운 네모 박스 & 분리형 링크) */
        .link-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .link-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fff8fa;
            border-radius: 12px;
            border: 1px solid rgba(241, 106, 139, 0.12);
            overflow: hidden;
            transition: background 0.2s;
        }

        .link-main {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            flex: 1;
            text-decoration: none;
            color: var(--text-dark);
            font-weight: 500;
        }

        .link-main:hover {
            background: rgba(241, 106, 139, 0.05);
        }

        .platform-icon {
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .copy-action {
            background: transparent;
            border: none;
            border-left: 1px solid rgba(241, 106, 139, 0.12);
            color: var(--main-pink);
            font-size: 0.85rem;
            font-weight: 500;
            padding: 0 16px;
            height: 100%;
            min-height: 50px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .copy-action:active {
            background: rgba(241, 106, 139, 0.15);
        }

        /* 시간표 */
        .schedule-list { display: flex; flex-direction: column; gap: 8px; }
        .schedule-item {
            display: flex;
            padding: 12px 16px;
            background: #fff8fa;
            border-radius: 10px;
            font-size: 0.95rem;
            align-items: center;
            border: 1px solid rgba(241, 106, 139, 0.06);
        }
        .schedule-item.today {
            background: rgba(241, 106, 139, 0.1);
            border: 1px solid var(--sub-pink);
            font-weight: 700;
        }
        .day-label { width: 60px; color: var(--main-pink); font-weight: 700; }
        .day-content { flex: 1; color: var(--text-dark); }
        .today-badge { background: var(--main-pink); color: white; font-size: 0.7rem; padding: 2px 8px; border-radius: 6px; margin-left: auto; }

        /* 방송 시청 규칙 */
        .rule-list { display: flex; flex-direction: column; gap: 12px; }
        .rule-item {
            background: #fff8fa;
            padding: 16px;
            border-radius: 12px;
            border-left: 4px solid var(--sub-pink);
            border-top: 1px solid rgba(241, 106, 139, 0.08);
            border-right: 1px solid rgba(241, 106, 139, 0.08);
            border-bottom: 1px solid rgba(241, 106, 139, 0.08);
        }
        .rule-title { font-weight: 700; margin-bottom: 6px; font-size: 0.95rem; color: var(--main-pink); }
        .rule-desc { font-size: 0.9rem; color: var(--text-dark); line-height: 1.5; }
        .rule-subtext { font-size: 0.85rem; color: var(--text-light); margin-top: 4px; }

        .rule-footer-card {
            background: rgba(247, 161, 180, 0.1);
            border: 1px dashed var(--sub-pink);
            padding: 16px;
            border-radius: 12px;
            text-align: center;
            font-size: 0.9rem;
            line-height: 1.5;
            color: var(--main-pink);
            font-weight: 500;
        }

        /* 작고 앙증맞은 하트 파티클 효과 */
        .heart-particle {
            position: fixed;
            pointer-events: none;
            font-size: 14px;
            color: var(--main-pink);
            animation: floatUp 0.8s ease-out forwards;
            z-index: 9999;
        }

        @keyframes floatUp {
            0% { opacity: 1; transform: translate(-50%, -50%) scale(0.6); }
            50% { opacity: 0.9; transform: translate(-50%, -90%) scale(1.1); }
            100% { opacity: 0; transform: translate(-50%, -130%) scale(0.9); }
        }

        /* 토스트 알림 */
        .toast {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(51, 51, 51, 0.85);
            color: white;
            padding: 10px 20px;
            border-radius: 10px;
            font-size: 0.9rem;
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
            z-index: 1000;
        }

        /* 숨겨진 파일 입력창 */
        #fileInput { display: none; }
        
        .reset-img-btn {
            background: none;
            border: none;
            color: var(--text-light);
            font-size: 0.8rem;
            margin-top: 8px;
            cursor: pointer;
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- 프로필 섹션 -->
        <div class="card profile-header">
            <div class="profile-img-wrap">
                <img src="https://via.placeholder.com/150/fff0f3/f16a8b?text=Som" alt="솜하치 프로필" class="profile-img" id="profileImage">
                <button type="button" class="img-edit-btn" onclick="triggerFileInput()" title="프로필 사진 바꾸기">📷</button>
            </div>
            <input type="file" id="fileInput" accept="image/*" onchange="handleImageUpload(event)">
            
            <div class="profile-name">솜하치</div>
            <div class="profile-sub">버츄얼 스트리머 / 팬네임 : 솜뭉치</div>
            <button type="button" class="reset-img-btn" onclick="resetProfileImage()">기본 프로필 사진으로 초기화</button>

            <div class="info-grid">
                <div class="info-row"><span class="info-label">활동 분야</span><span class="info-value">버츄얼 스트리머</span></div>
                <div class="info-row"><span class="info-label">방송 플랫폼</span><span class="info-value">치지직 / 유튜브</span></div>
                <div class="info-row"><span class="info-label">생일</span><span class="info-value">2002. 01. 04</span></div>
                <div class="info-row"><span class="info-label">데뷔일</span><span class="info-value">2025. 07. 06</span></div>
                <div class="info-row"><span class="info-label">팬덤명</span><span class="info-value">솜뭉치</span></div>
            </div>
            
            <div class="tag-list">
                <span class="tag">게임</span>
                <span class="tag">노래</span>
                <span class="tag">잡담 & 소통</span>
            </div>

            <div class="d-day-wrap">
                <div class="d-day-box">
                    <div class="d-day-title">생일 (01.04)</div>
                    <div class="d-day-value" id="birthdayDday">D-?</div>
                </div>
                <div class="d-day-box">
                    <div class="d-day-title">데뷔 (25.07.06)</div>
                    <div class="d-day-value" id="debutDplus">D+?</div>
                </div>
            </div>
        </div>

        <!-- 공식 채널 링크 -->
        <div class="card">
            <div class="section-title">공식 채널</div>
            <div class="link-list">
                <div class="link-item">
                    <a href="https://chzzk.naver.com" target="_blank" rel="noopener noreferrer" class="link-main">
                        <div class="platform-icon">📺</div>
                        <span>치지직 (Chzzk)</span>
                    </a>
                    <button type="button" class="copy-action" onclick="copyText('https://chzzk.naver.com', event)">복사</button>
                </div>
                <div class="link-item">
                    <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="link-main">
                        <div class="platform-icon">▶️</div>
                        <span>유튜브 (YouTube)</span>
                    </a>
                    <button type="button" class="copy-action" onclick="copyText('https://youtube.com', event)">복사</button>
                </div>
                <div class="link-item">
                    <a href="https://discord.com" target="_blank" rel="noopener noreferrer" class="link-main">
                        <div class="platform-icon">💬</div>
                        <span>디스코드 (Discord)</span>
                    </a>
                    <button type="button" class="copy-action" onclick="copyText('https://discord.com', event)">복사</button>
                </div>
            </div>
        </div>

        <!-- 주간 방송 시간표 -->
        <div class="card">
            <div class="section-title">방송 시간표 (오후 7시 시작)</div>
            <div class="schedule-list" id="scheduleList">
                <div class="schedule-item" data-day="1"><span class="day-label">월요일</span><span class="day-content">옵치 리플데이</span></div>
                <div class="schedule-item" data-day="2"><span class="day-label">화요일</span><span class="day-content">정기 휴방</span></div>
                <div class="schedule-item" data-day="3"><span class="day-label">수요일</span><span class="day-content">저챗 (Just Chatting)</span></div>
                <div class="schedule-item" data-day="4"><span class="day-label">목요일</span><span class="day-content">정기 휴방</span></div>
                <div class="schedule-item" data-day="5"><span class="day-label">금요일</span><span class="day-content">공포게임 및 저챗</span></div>
                <div class="schedule-item" data-day="6"><span class="day-label">토요일</span><span class="day-content">노래방 및 소통</span></div>
                <div class="schedule-item" data-day="0"><span class="day-label">일요일</span><span class="day-content">정기 휴방</span></div>
            </div>
        </div>

        <!-- 방송 시청 규칙 -->
        <div class="card">
            <div class="section-title">방송 시청 규칙</div>
            <div class="rule-list">
                <div class="rule-item">
                    <div class="rule-title">인사 규칙</div>
                    <div class="rule-desc">입장 인사 : <strong>"솜하"</strong> 🩷<br>방종 인사 : <strong>"솜바"</strong> 🌙</div>
                    <div class="rule-subtext">"솜바"는 되도록 방송 종료 시에만 사용해주세요. 먼저 나가야 할 경우에는 조용히 나가셔도 괜찮습니다. 😊</div>
                </div>
                <div class="rule-item">
                    <div class="rule-title">채팅 예절</div>
                    <div class="rule-desc">
                        - 다짜고짜 반말이나 욕설은 삼가주세요.<br>
                        - 무지성 비난이나 과도한 욕설은 자제해주세요.<br>
                        - 긁는 채팅은 삼가주세요.<br>
                        - 무분별한 도배 및 광고·홍보는 금지입니다.<br>
                        - 방송 중에 ~해주세요 채팅 치지 말아주세요.<br>
                        - 방송과 관련 없는 일기, 메모장 식의 채팅, 과도한 강요는 자제해주세요.
                    </div>
                    <div class="rule-subtext">💗 단, 소통 시간에는 편하게 이야기하셔도 됩니다. ( 단 적정 선은 지켜주세요! )</div>
                </div>
                <div class="rule-item">
                    <div class="rule-title">방송 관련</div>
                    <div class="rule-desc">
                        - 타 스트리머 언급이나 스트리머 티 내기는 자제해주세요. (✅ 솜하치가 먼저 언급한 경우에는 괜찮습니다.)<br>
                        - 이 방송은 솜하치의 방송입니다. 진행 방식은 방장의 판단을 존중해주세요.<br>
                        - 의견이나 훈수는 제가 먼저 요청할 때 부탁드립니다.
                    </div>
                </div>
                <div class="rule-item">
                    <div class="rule-title">게임 방송 관련</div>
                    <div class="rule-desc">
                        - 스토리 게임에서는 스포일러 및 과도한 추측 채팅을 자제해주세요.<br>
                        - 게임과 관련 없는 채팅 금지입니다.<br>
                        - 훈수는 제가 먼저 물어보거나 요청할 때만 부탁드립니다. ◡̈
                    </div>
                </div>
                <div class="rule-footer-card">
                    🌸 함께 좋은 방송 만들어가요! 🌸<br>
                    모두가 즐거운 방송을 위해 규칙을 꼭 지켜주세요.<br>
                    위 사항을 지키지 않을 경우 방송 운영 방침에 따라 불이익이 있을 수 있습니다.<br>
                    서로를 존중하며 편안한 분위기에서 즐겨주시면 감사하겠습니다. 🩷
                </div>
            </div>
        </div>
    </div>

    <div id="toast" class="toast">주소가 복사되었습니다</div>

    <script>
        // 1. 작고 앙증맞은 하트 파티클 효과
        document.addEventListener('click', function(e) {
            if(e.target.tagName === 'BUTTON' || e.target.tagName === 'A' || e.target.closest('button') || e.target.closest('a')) return;

            const heart = document.createElement('div');
            heart.innerHTML = '🩷';
            heart.className = 'heart-particle';
            heart.style.left = e.clientX + 'px';
            heart.style.top = e.clientY + 'px';
            document.body.appendChild(heart);

            setTimeout(() => {
                heart.remove();
            }, 800);
        });

        // 2. 프로필 사진 업로드 및 로컬스토리지 영구 저장
        window.onload = function() {
            const savedImg = localStorage.getItem('somhachiProfileImg');
            if (savedImg) {
                document.getElementById('profileImage').src = savedImg;
            }
            calculateDates();
            highlightToday();
        };

        function triggerFileInput() {
            const fileInput = document.getElementById('fileInput');
            if (fileInput) {
                fileInput.click();
            }
        }

        function handleImageUpload(event) {
            const file = event.target.files[0];
            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    alert('용량이 너무 큽니다! 5MB 이하의 이미지를 선택해주세요.');
                    return;
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    const base64Data = e.target.result;
                    document.getElementById('profileImage').src = base64Data;
                    try {
                        localStorage.setItem('somhachiProfileImg', base64Data);
                    } catch (err) {
                        alert('저장 공간이 부족합니다. 용량이 더 작은 사진을 선택해 주세요.');
                    }
                };
                reader.readAsDataURL(file);
            }
        }

        function resetProfileImage() {
            const defaultImg = 'https://via.placeholder.com/150/fff0f3/f16a8b?text=Som';
            document.getElementById('profileImage').src = defaultImg;
            localStorage.removeItem('somhachiProfileImg');
            alert('기본 프로필 사진으로 초기화되었습니다.');
        }

        // 3. 실시간 날짜 계산 (생일 D-Day, 데뷔 D+)
        function calculateDates() {
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            let bday = new Date(today.getFullYear(), 0, 4); 
            if (today > bday) {
                bday.setFullYear(today.getFullYear() + 1);
            }
            const bdayDiff = Math.ceil((bday - today) / (1000 * 60 * 60 * 24));
            document.getElementById('birthdayDday').innerText = bdayDiff === 0 ? 'D-Day' : 'D-' + bdayDiff;

            const debutDate = new Date(2025, 6, 6); // 7월 6일
            const debutDiff = Math.floor((today - debutDate) / (1000 * 60 * 60 * 24));
            
            if (debutDiff < 0) {
                document.getElementById('debutDplus').innerText = 'D' + debutDiff;
            } else {
                document.getElementById('debutDplus').innerText = 'D+' + (debutDiff + 1);
            }
        }

        // 4. 오늘 요일 하이라이트
        function highlightToday() {
            const todayDay = new Date().getDay(); 
            const scheduleItems = document.querySelectorAll('.schedule-item');
            
            scheduleItems.forEach(item => {
                if (parseInt(item.getAttribute('data-day')) === todayDay) {
                    item.classList.add('today');
                    const badge = document.createElement('span');
                    badge.className = 'today-badge';
                    badge.innerText = '오늘';
                    item.appendChild(badge);
                }
            });
        }

        // 5. 복사 기능
        function copyText(text, event) {
            event.preventDefault();
            navigator.clipboard.writeText(text).then(() => {
                const toast = document.getElementById('toast');
                toast.style.opacity = '1';
                setTimeout(() => {
                    toast.style.opacity = '0';
                }, 2000);
            });
        }
    </script>
</body>
</html>
